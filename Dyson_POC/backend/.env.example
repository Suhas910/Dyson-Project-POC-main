# Copy this file to backend/.env and fill in the key.
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored. Never commit a real key.
# Restart the backend after editing — the file is read once at startup.

# --- Required ---------------------------------------------------------------
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# --- Optional ---------------------------------------------------------------
# Any model slug from https://openrouter.ai/models. The default is an alias
# that always points at the newest DeepSeek V4 Flash release, so the pipeline
# picks up new versions without a code change.
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest

# This model reasons before answering, and does so by default. On these tasks
# reasoning costs about 5x the latency (29s vs 5s on a measured summary call)
# without producing better commentary, so it is off by default.
# Set to low / high / max to turn it back on.
OPENROUTER_REASONING_EFFORT=none

# Per-request budget. A hung provider must not hang the analysis, so this is
# deliberately shorter than the frontend's patience.
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_OUTPUT_TOKENS=4096

# Only needed to point at a different OpenAI-compatible gateway.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Attribution shown on the OpenRouter dashboard.
# OPENROUTER_APP_TITLE=Dyson DFM Analysis
# OPENROUTER_APP_URL=https://github.com/Suhas910/Dyson-Project-POC-main
